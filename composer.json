{
    "name": "infrangible/m2-cms-storage",
    "description": "Allows uploading MP4, PDF, SVG, WebP and ZIP files in the Magento media gallery and adds a file manager page under Content > Elements.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Content",
        "Admin tools",
        "upload PDF and SVG in the media gallery",
        "WebP and MP4 uploads",
        "file manager for media"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-cms-storage",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-backend-widget": "~2.7.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CmsStorage\\": "src"
        }
    }
}
